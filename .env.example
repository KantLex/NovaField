# ComfyUI server NovaField starts on. Easier: click the server status in the header and pick a
# local ComfyUI or Comfy Cloud on the Connection screen (saved in data/connection.json, which wins).
COMFY_URL=http://127.0.0.1:8188
# 1 = simulate renders locally (still validates graphs against the server).
NOVAFIELD_DRY_RUN=0
# Comfy account API key for ComfyUI API nodes (GPT Image, Flux Pro, Kling…), billed to that account.
# Create one at https://platform.comfy.org. Leave empty if you only run local models. Can also be
# set on the Connection screen.
COMFY_API_KEY=
# Where the "Install NovaField nodes" button installs the node pack from (see docs/releasing-nodes.md).
NOVAFIELD_NODES_REPO=https://github.com/KantLex/ComfyUI-NovaField
NOVAFIELD_NODES_PUBLISHER=novafield
