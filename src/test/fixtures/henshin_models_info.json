 "SCAIL2ColoredMask": {
  "input": {
   "required": {
    "driving_track_data": [
     "SAM3_TRACK_DATA",
     {
      "tooltip": "SAM3 track of the driving pose video. Will be rendered into the pose_video_mask output."
     }
    ],
    "object_indices": [
     "STRING",
     {
      "tooltip": "Comma-separated list of person indices to include (e.g. '0,2,3'). Applied to both reference and pose video masks. Empty = all.",
      "default": "",
      "multiline": false
     }
    ],
    "sort_by": [
     "COMBO",
     {
      "tooltip": "Order in which palette colors are assigned to the tracked objects (applied to both reference and pose video so each identity keeps the same color). Objects that appear in earlier frames always come first; within a frame, left_to_right = leftmost object (by centroid at first appearance) gets the first color, area = biggest object (by mask area at first appearance) gets the first color; none = keep SAM3's order.",
      "default": "left_to_right",
      "multiselect": false,
      "options": [
       "none",
       "left_to_right",
       "area"
      ]
     }
    ],
    "replacement_mode": [
     "BOOLEAN",
     {
      "tooltip": "False = Animation Mode (pose_video_mask has black background, reference_image_mask has white background). True = Replacement Mode (pose_video_mask has white background, reference_image_mask has black background).",
      "default": false
     }
    ]
   },
   "optional": {
    "ref_track_data": [
     "SAM3_TRACK_DATA,MASK",
     {
      "display_name": "reference_masks",
      "tooltip": "SAM3 track of the reference image(s) (one identity per object, colored in batch order), or a plain MASK of the reference subject (rendered as a single identity)."
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "driving_track_data",
    "object_indices",
    "sort_by",
    "replacement_mode"
   ],
   "optional": [
    "ref_track_data"
   ]
  },
  "is_input_list": false,
  "output": [
   "IMAGE",
   "IMAGE"
  ],
  "output_is_list": [
   false,
   false
  ],
  "output_name": [
   "pose_video_mask",
   "reference_image_mask"
  ],
  "output_tooltips": [
   null,
   null
  ],
  "output_matchtypes": null,
  "name": "SCAIL2ColoredMask",
  "output_node": false,
  "has_intermediate_output": false
 },
